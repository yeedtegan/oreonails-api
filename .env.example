PORT=4000
DATABASE_PATH=./data/oreonails.db
# Comma-separated browser origins allowed by CORS (the web app proxies /api, so this is only for direct calls)
CORS_ORIGINS=http://localhost:3000
# Enables /api/admin/* when set
ADMIN_TOKEN=

# Storefront URL (payment providers redirect customers back here)
WEB_URL=http://localhost:3000

# Card payments, Apple Pay, Google Pay, Klarna… via Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Webhook endpoint: <API URL>/api/webhooks/stripe, event payment_intent.succeeded
STRIPE_WEBHOOK_SECRET=

# PayPal Checkout (https://developer.paypal.com/dashboard/applications)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Built-in test card gateway. Defaults to on when STRIPE_SECRET_KEY is empty. Never enable in production.
# TEST_PAYMENTS=false

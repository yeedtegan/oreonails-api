{
  "name": "oreonails-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "seed": "node --env-file-if-exists=.env --import tsx src/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "import:sqlite": "node --env-file-if-exists=.env --import tsx src/db/import-sqlite.ts",
    "db:up": "docker compose up -d --wait"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.19",
    "hono": "^4.13.18",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
